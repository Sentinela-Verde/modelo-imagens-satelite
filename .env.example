# Copie para .env e preencha. .env nunca deve ser commitado (ver .gitignore).

# ID do projeto Google Cloud usado por ee.Initialize(project=...)
EE_PROJECT=

# Caminho ABSOLUTO para a chave de service account do Earth Engine, FORA deste repositório.
# Nunca coloque esse arquivo dentro da pasta do projeto.
EE_SERVICE_ACCOUNT_KEY=

DATA_ROOT=./data
RANDOM_SEED=42
